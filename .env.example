# LINE° Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# ─── Paystack (Frontend - Safe to expose) ─────────────────────────────────────
VITE_PAYSTACK_PUBLIC_KEY=pk_live_YOUR_PAYSTACK_PUBLIC_KEY
VITE_PAYSTACK_ENABLED=true

# ─── Flutterwave (Frontend - Safe to expose) ──────────────────────────────────
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-YOUR_FLUTTERWAVE_PUBLIC_KEY
VITE_FLUTTERWAVE_ENABLED=true

# ─── Server-side ONLY (NEVER add VITE_ prefix to these) ──────────────────────
# These are for your backend/edge functions ONLY.
# NEVER expose these to the frontend.

# Paystack secret key (server-side webhook verification)
# PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_SECRET_KEY

# Flutterwave secret key (server-side webhook verification)
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-YOUR_FLUTTERWAVE_SECRET_KEY

# CJ Dropshipping credentials (server-side fulfillment)
# CJ_API_KEY=YOUR_CJ_API_KEY
# CJ_EMAIL=YOUR_CJ_ACCOUNT_EMAIL

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_URL=https://yourdomain.com
